<!DOCTYPE html>
<html lang="et">
<head>
  <meta charset="UTF-8">
  <title>Veebileht</title>
  
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0px;
        background-color: #f5f5f5;
      }

      #päis {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #b3b3b3;
        padding: 15px 30px;
        color: white;
      }

      #päis .logo {
        font-weight: bold;
        font-size: 18px;
      }

      #päis .nav-lingid a {
        color: white;
        text-decoration: none;
        margin-left: 15px;
      }

      #päis .nav-lingid a:hover {
        text-decoration: underline;
      }

      #hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background-color: #eaeaea;
        padding: 140px 20px;
        text-align: center;
        margin-bottom: 20px;
      }

      #hero h1 {
        margin: 0 0 10px 0;
        font-size: 32px;
      }

      #hero p {
        margin: 0;
        color: #555;
      }

      #sisukord {
        background-color: #eaeaea;
        padding: 15px;
        width: 200px;
        box-sizing: border-box;
        margin-left: 20px;
      }

      #sisukord h3 {
        margin: 0 0 10px 0;
        font-size: 16px;
        border-bottom: 1px solid #b1b1b1;
        padding-bottom: 5px;
      }

      #sisukord ul {
        list-style-type: disc;
        padding-left: 20px;
        margin: 0;
      }

      #sisukord li {
        margin-bottom: 6px;
      }

      #sisukord a {
        color: #000000;
        text-decoration: none;
      }

      #sisukord a:hover {
        text-decoration: underline;
      }
    </style>

</head>
<body>

  <header id="päis">
    <div class="logo">Lehenimi ja Logo</div>
    <nav class="nav-lingid">
      <a href="#">Koduleht</a>
      <a href="#">Kes ja Kus?</a>
      <a href="#">Kõik Teemad</a>
    </nav>
  </header>

  <section id="hero">
    <h1>Leht</h1>
    <p>Lühikene kirjeldus leheküljest</p>
  </section>

  <aside id="sisukord">
    <h3>Sisukord</h3>
    <ul>
      <li><a href="#">Pealkiri</a></li>
      <li><a href="#">Pealkiri</a></li>
      <li><a href="#">Pealkiri</a></li>
      <li><a href="#">Pealkiri</a></li>
      <li><a href="#">Pealkiri</a></li>
    </ul>
  </aside>

</body>
</html>
